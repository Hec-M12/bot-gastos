# Copiá este archivo como .env y llenalo. El .env NUNCA se sube a internet (está en .gitignore).
# No le pongas comillas ni espacios alrededor del =.

# 1) OBLIGATORIO: el token que te da @BotFather en Telegram
TELEGRAM_TOKEN=pega-aqui-tu-token

# (Opcional) Si ya sabés tu chat id. Si lo dejás vacío, el bot te pide un código de 6 números la primera vez.
TELEGRAM_CHAT_ID=

# 2) OPCIONAL: correo del banco (Gmail con contraseña de aplicación de 16 letras, NO tu contraseña normal)
CORREO_USUARIO=
CORREO_CLAVE_APP=

# 3) OPCIONAL: leer screenshots. Poné UNA llave. Gemini tiene capa gratis (aistudio.google.com/apikey).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Si tenés más de una llave, elegí cuál usar: gemini, openai o anthropic
VISION_PROVEEDOR=
# Para cambiar el modelo (normalmente dejalo vacío)
VISION_MODELO=
